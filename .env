# These values apply to every mode, production builds included.
#
# To point the app somewhere else while developing, put the override in
# .env.development.local, not .env.local. Vite reads .env.local in every mode,
# so a value left there also ends up in the published bundle.

VITE_GENET_MUSIC_LIST_URL=https://nanase.cc/asset/kemov/genet/music/streaming.yml
VITE_GENET_MUSIC_LIST_SUB_URL=
