{
  "name": "kemov",
  "version": "1.4.5",
  "private": true,
  "type": "module",
  "engines": {
    "npm": "use bun instead"
  },
  "scripts": {
    "dev": "vite",
    "build": "bun run --parallel type-check build-only",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit",
    "type-check:worker": "tsc --noEmit -p worker/tsconfig.json",
    "lint": "eslint . --fix",
    "lint:style": "stylelint src/**/*.{css,scss,vue}",
    "check-channels": "node scripts/check-channels.js",
    "build-channels-sql": "node scripts/build-channels-sql.js",
    "check-secrets": "node scripts/check-secrets.js",
    "format": "prettier --write .",
    "test": "vitest",
    "coverage": "vitest run --coverage --project frontend --project scripts"
  },
  "resolutions": {
    "vue": "^3",
    "vuetify": "^3",
    "dayjs": "^1"
  },
  "dependencies": {
    "@vueuse/core": "^12.8.2",
    "dayjs": "^1.11.23",
    "js-yaml": "^4.3.2",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260910.1",
    "@eslint/js": "^10.0.1",
    "@mdi/font": "^7.4.47",
    "@nanase/alnilam": "github:nanase/alnilam#2c6e072cdb4b6124d98484de033238e46710a502",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.2",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue-macros/volar": "^0.30.15",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "axios": "^1.20.0",
    "axios-retry": "^4.5.0",
    "dompurify": "^3.4.15",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.11.0",
    "floating-vue": "^5.4.0",
    "marked": "^15.0.12",
    "pinia": "^3.0.4",
    "postcss": "^8.5.28",
    "postcss-html": "^1.8.1",
    "prettier": "^3.9.6",
    "sass": "^1.104.0",
    "stylelint": "^16.26.1",
    "stylelint-config-standard-scss": "^14.0.0",
    "stylelint-config-standard-vue": "^1.0.0",
    "typescript": "5.9.3",
    "unplugin-vue-macros": "^2.14.5",
    "v3-infinite-loading": "^1.3.2",
    "vite": "^6.4.3",
    "vite-plugin-html-inject": "^1.1.2",
    "vite-plugin-webfont-dl": "^3.13.1",
    "vitest": "^4.1.11",
    "vue-router": "^4.6.4",
    "vue-tsc": "^2.2.12",
    "vuetify": "^3.13.4",
    "wrangler": "^4.131.0"
  }
}
