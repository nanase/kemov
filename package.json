{
  "name": "kemov",
  "version": "1.4.5",
  "private": true,
  "type": "module",
  "engines": {
    "npm": "use yarn instead",
    "yarn": "4.6.0"
  },
  "packageManager": "yarn@4.6.0",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check build-only",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --fix",
    "lint:style": "stylelint src/**/*.{css,scss,vue}",
    "format": "prettier --write src/",
    "test": "vitest",
    "coverage": "vitest run --coverage"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix",
    "*.{css,scss,vue}": "stylelint --fix",
    "*": "prettier -w -u"
  },
  "resolutions": {
    "vue": "^3",
    "vuetify": "^3",
    "dayjs": "^1"
  },
  "dependencies": {
    "@vueuse/core": "^12.8.2",
    "dayjs": "^1.11.23",
    "js-yaml": "^4.3.2",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mdi/font": "^7.4.47",
    "@nanase/alnilam": "https://github.com/nanase/alnilam.git#commit=b7f1229a752132e130aadd536889326428ea823a",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "^3.2.7",
    "@vue-macros/volar": "^0.30.15",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "axios": "^1.20.0",
    "axios-retry": "^4.5.0",
    "dompurify": "^3.2.4",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.10.0",
    "floating-vue": "^5.2.2",
    "marked": "^15.0.12",
    "npm-run-all": "^4.1.5",
    "pinia": "^3.0.4",
    "postcss": "^8.5.26",
    "postcss-html": "^1.8.1",
    "prettier": "^3.9.6",
    "sass": "^1.103.1",
    "stylelint": "^16.26.1",
    "stylelint-config-standard-scss": "^14.0.0",
    "stylelint-config-standard-vue": "^1.0.0",
    "typescript": "5.9.3",
    "unplugin-vue-macros": "^2.14.5",
    "v3-infinite-loading": "^1.3.2",
    "vite": "^6.4.3",
    "vite-plugin-html-inject": "^1.1.2",
    "vite-plugin-webfont-dl": "^3.13.1",
    "vitest": "^3.2.7",
    "vue-router": "^4.6.4",
    "vue-tsc": "^2.2.12",
    "vuetify": "^3.13.2"
  }
}
