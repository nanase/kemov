{
  "name": "kemov",
  "version": "1.4.5",
  "private": true,
  "type": "module",
  "engines": {
    "npm": "use bun instead"
  },
  "scripts": {
    "dev": "vite",
    "build": "bun run --parallel type-check build-only",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "type-check:worker": "tsc --noEmit -p worker/tsconfig.json",
    "lint": "eslint . --fix",
    "lint:style": "stylelint src/**/*.{css,scss,vue}",
    "check-secrets": "node scripts/check-secrets.js",
    "screenshot": "node scripts/screenshot.js",
    "format": "prettier --write .",
    "test": "vitest",
    "coverage": "vitest run --coverage --project frontend --project scripts"
  },
  "resolutions": {
    "vue": "^3",
    "dayjs": "^1"
  },
  "dependencies": {
    "dayjs": "^1.11.23",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@cloudflare/workers-types": "^5.20261011.1",
    "@eslint/js": "^10.0.1",
    "@nanase/alnilam": "github:nanase/alnilam#2c6e072cdb4b6124d98484de033238e46710a502",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue-macros/volar": "^3.1.4",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "axios": "^1.20.0",
    "axios-retry": "^4.5.0",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "playwright": "^1.64.0",
    "postcss": "^8.5.29",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-config-standard-vue": "^2.0.0",
    "typescript": "6.0.3",
    "unplugin-vue-macros": "^2.14.5",
    "v3-infinite-loading": "^1.3.2",
    "vite": "^8.3.4",
    "vite-plugin-html-inject": "^1.1.2",
    "vite-plugin-webfont-dl": "^3.13.1",
    "vitest": "^4.1.11",
    "vue-router": "^5.4.0",
    "vue-tsc": "^3.3.13",
    "wrangler": "^4.149.0"
  }
}
